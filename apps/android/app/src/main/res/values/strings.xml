<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The visible spelling is Hælan in every language. Everything that is typed,
         package included, stays haelan. The app speaks English and Dutch (values-nl):
         every translatable string lives in both, and MissingTranslation enforces it. -->
    <string name="app_name" translatable="false">Hælan</string>

    <!-- Login: same copy as the web (signIn.* + shell.sessionExpired). The brand mark is not a
         string: it is the vector drawable, as on the web sign-in card. -->
    <string name="login_title">Sign in</string>
    <string name="login_server">Instance address</string>
    <string name="login_server_hint">http://192.168.x.x:4235</string>
    <string name="login_username">Username</string>
    <string name="login_password">Password</string>
    <string name="login_submit">Sign in</string>
    <string name="login_working">Signing in</string>
    <string name="login_failed">That username and password do not match an account on this instance.</string>
    <string name="login_server_invalid">That is not an instance address. It looks like http://192.168.1.10:4235.</string>
    <string name="login_expired">The session ended. Sign in again to continue.</string>
    <string name="login_insecure">Secure storage is unavailable on this device, so settings are kept unencrypted.</string>

    <!-- Why an exchange with the instance produced no answer. One sentence per reason, because a
         typo in the address, a stopped instance, an untrusted certificate and a page that is not
         haelan ask different things of the person, and every one of them used to read the same
         "the instance did not answer" (A-18). -->
    <string name="error_unknown_host">That address does not resolve. Check the name and that the phone is on the same network.</string>
    <string name="error_refused">Nothing is listening at that address. Check that the instance is running and that the port is right.</string>
    <string name="error_timeout">The instance did not answer in time.</string>
    <string name="error_certificate">The phone refused the instance certificate, so nothing was sent. The instance has to be reached over http on the local network, or behind a certificate the phone trusts.</string>
    <string name="error_not_instance">Something answered, and it is not a Hælan instance.</string>
    <string name="error_broken">The connection to the instance broke before it answered.</string>
    <string name="error_not_your_person">This sign-in cannot send data for that person. Sign in again.</string>
    <string name="error_too_large">The instance refused the request for its size. The sync sends a type in blocks, so this is a point too large to send alone.</string>
    <string name="error_instance">The instance answered %1$d.</string>

