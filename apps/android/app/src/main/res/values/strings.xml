    <!-- The sync no longer writes a log: the three bars say how far along it is, and the two sentences that
         remain are the ones that must reach whoever presses the button (nothing to send, and the
         sync stopping). Every other reason goes to logcat. -->
    <string name="sync_none">Switch on at least one data type.</string>
    <string name="sync_failed">Sync stopped: %1$s</string>
    <string name="type_failed">This type was not sent.</string>
    <string name="type_sent">This type has been sent.</string>

    <!-- A gap reads as a timestamp that stopped moving, not as a missing failure. Each
         row names its last finished run, so a day without any run is visible there. -->
    <string name="status_never">Never synced</string>
    <!-- The absolute time beside the relative sentence, so today still says when. -->
    <string name="status_at">%1$s (%2$s)</string>
    <string name="status_sent_today">Last sent today</string>
    <plurals name="status_sent_days">
        <item quantity="one">Last sent %d day ago</item>
        <item quantity="other">Last sent %d days ago</item>
    </plurals>
    <string name="status_empty_today">Checked today, no data in Health Connect</string>
    <plurals name="status_empty_days">
        <item quantity="one">No data, last checked %d day ago</item>
        <item quantity="other">No data, last checked %d days ago</item>
    </plurals>

    <!-- Doze and the vendor battery savers stop the background run without a failure,
         which is worse than an error because nothing looks wrong. The card says so and names
         the one setting that keeps the twice daily run on schedule. -->
    <string name="battery_title">Background sync</string>
    <string name="battery_body">Android can pause Hælan to save battery, so the twice daily sync may not run for days. Turning off battery optimization for Hælan keeps it on schedule. Nothing else changes.</string>
    <string name="battery_exempt">Battery optimization is off for Hælan, so the background sync can run.</string>
    <string name="battery_action">Open battery settings</string>

