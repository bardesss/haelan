<?xml version="1.0" encoding="utf-8"?>
<!-- Il marchio: una H il cui traverso e' un battito. Le due forme sono quelle di
     assets/brand/mark.svg, riscritte qui perche' una risorsa Android non legge un SVG a runtime,
     mentre il colore non e' riscritto: e' @color/accent, cioe' il token, che cambia con il tema
     perche' values e values-night lo definiscono due volte (T7.1).
     Sul web il marchio prende currentColor dall'elemento che lo contiene; un vector drawable non
     eredita nessun colore, quindi qui l'equivalente e' il token. Una superficie che lo volesse in
     un altro tono lo tinta con app:tint sulla ImageView, che sovrascrive questo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5,4L5,20M19,4L19,20"
        android:strokeColor="@color/accent"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M5,12H8.9L9.8,13.5L11.2,7.3L13,15.9L14,12H19"
        android:strokeColor="@color/accent"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
