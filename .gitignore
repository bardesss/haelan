node_modules/
dist/
# The assembled landing page. Already covered by `dist/` above; spelled out anyway so a reader
# scanning this file sees that the assembly (built by `pnpm site:build` from site/ and published
# by pages.yml) is deliberately untracked, not merely caught in passing.
site/dist/
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env
.superpowers/
docs/
probe/samples/
probe/.tokens.json
probe/findings/token-log.jsonl
.env.local
*.tsbuildinfo
# A local instance's data directory: a real refresh token and real health data.
.local-data/
# Any other local instance, including the ones scripts/seed-demo.mjs exists to create. Only
# .local-data was listed, so a seeded demo directory beside it was tracked by default: harmless
# in content, since the seed is synthetic, and still a database committed to a public repository
# by accident. The glob covers the next one too.
.local-*/
# ...except the one this repository's own README tells you to create. "Try it without a Google
# account" runs `seed-demo.mjs ./demo-data`, and the glob above is dot-prefixed, so the single
# directory every reader of the README is instructed to make was the one case it did not cover.
# Found by a `git add -A` that staged demo-data/instance.key while updating the screenshots those
# same instructions produce.
demo-data/

# Linked worktrees. Kept out of the tree they live in: a git add -A from the repository root
# would otherwise record one as an embedded repository and commit a gitlink nobody wanted.
.worktrees/

# The demo capture's own output: a manifest plus one JSON file per recorded response, regenerated
# by `pnpm demo:capture` on every deploy (Task 3's own comment on why it lives outside
# apps/web/public/ - Vite copies public/ verbatim into every build, including a real instance's,
# and this directory must never ship in one of those).
demo/capture/out/

# `pnpm demo:build`'s own output (vite.demo.config.ts's outDir). Not `dist/`, so the pattern above
# does not already cover it, and it is exactly as regenerable as a real instance's own `dist/`.
apps/web/dist-demo/

# Local editor and agent state: settings.local.json, a scheduled-task lock, worktree bookkeeping,
# and a launch.json naming this machine's dev servers. None of it describes the project, and
# settings.local.json is the kind of file that carries local paths into a public repository.
.claude/
