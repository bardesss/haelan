{
  "name": "haelan",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter @haelan/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/tokens/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "dev": "pnpm --filter @haelan/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite-node": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
