{
  "name": "haelan",
  "private": true,
  "version": "1.37.0",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "pnpm --filter @haelan/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/tokens/tsconfig.json --noEmit && tsc -p packages/core/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit && tsc -p demo/capture/tsconfig.json --noEmit",
    "dev": "pnpm --filter @haelan/web dev",
    "dev:server": "pnpm --filter @haelan/server dev",
    "start": "node --experimental-strip-types apps/server/src/index.ts",
    "check:enums": "node --experimental-strip-types scripts/check-enum-drift.mjs",
    "docs:tools": "node --experimental-strip-types scripts/generate-tools-doc.mjs",
    "readme:screenshots": "node scripts/sync-readme-screenshots.mjs",
    "site:build": "pnpm --filter @haelan/tokens build:css && node scripts/build-site.mjs",
    "demo:capture": "node scripts/capture-demo.mjs",
    "demo:build": "pnpm --filter @haelan/tokens build:css && pnpm --filter @haelan/web exec vite build --config vite.demo.config.ts",
    "layout:check": "node scripts/layout-check.mjs",
    "layout:check:boot": "node scripts/layout-check-boot.mjs",
    "demo:all": "pnpm demo:capture && pnpm demo:build && pnpm site:build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.14.3",
    "playwright": "1.56.0",
    "typescript": "^7.0.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
