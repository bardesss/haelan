# Hooks and shell scripts must keep LF wherever they are checked out. A commit-msg hook whose
# shebang line ends in CRLF is not executable on Linux, which would silently disable the guard
# for exactly the contributors who did not write it.
.githooks/** text eol=lf
*.sh text eol=lf

# TOOLS.md is generated by `pnpm docs:tools` and its bytes are compared against that
# generator's output by apps/server/test/tools-doc-drift.test.ts. Checked out with CRLF - which
# core.autocrlf=true does on Windows - that comparison fails on a clean clone, for a file nobody
# edited. CI runs on Linux and never sees it.
TOOLS.md text eol=lf
